# --- Database ---
DATABASE_URL=postgres://campionature:campionature@localhost:5442/campionature

# --- Reverse proxy ---
# "true" solo se l'app è dietro a un proxy fidato (nginx, Traefik, Caddy...) che imposta
# X-Real-IP / X-Forwarded-For: serve per i limiti di frequenza per IP di login e modulo pubblico.
TRUST_PROXY=false

# --- Segreto dell'app ---
# Firma il gettone anti-bot del modulo pubblico (/richiedi-campioni). Consigliato in produzione
# (se vuoto si usa un valore derivato da DATABASE_URL). Genera con: openssl rand -hex 32
APP_SECRET=

# --- Attività programmate (export m² mensile verso il CRM) ---
# Lo scheduler interno chiama /api/cron/export-crm ogni ora. CRON_SECRET protegge l'endpoint
# (se vuoto si usa un valore derivato da DATABASE_URL); per usare un cron esterno al suo posto:
# SCHEDULER_ENABLED=false e una chiamata oraria POST con "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
SCHEDULER_ENABLED=true

# --- URL pubblico dell'app (usato nei link delle email) ---
APP_URL=http://localhost:3000

# --- Email (SMTP) ---
# In sviluppo punta a Mailpit (docker compose up). In produzione: server SMTP di BGP.
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Se "true" le email non vengono inviate ma solo registrate nel log (utile per test).
EMAIL_DRY_RUN=false

# --- Primo amministratore (usato da `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@bgpgroup.it
SEED_ADMIN_PASSWORD=cambiami-subito

# --- Solo sviluppo: password degli utenti creati da `npm run db:seed-demo` ---
DEMO_PASSWORD=demo-campioni-2026
